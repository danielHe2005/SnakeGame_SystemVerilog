module keyboardTranslate(clk, reset, valid, makeBreak, outCode, directionCommand);
	input logic clk, reset, valid, makeBreak;
	input logic [7:0] outCode;
	output logic [3:0] directionCommand;
	
	enum {IDLE, LP, RP, UP, DP} ps, ns;
	
	always_comb begin
		case(ps)
			IDLE: begin ns = (valid&makeBreak)?((outCode == 8'h75)?UP:(outCode == 8'h6B)?LP:(outCode == 8'h72)?DP:(outCode == 8'h74)?RP:IDLE):IDLE;
							directionCommand = 4'b0000;
					end
			LP: begin ns = (valid&makeBreak)?((outCode == 8'h75)?UP:(outCode == 8'h6B)?LP:(outCode == 8'h72)?DP:(outCode == 8'h74)?RP:IDLE):IDLE;
							directionCommand = 4'b1000;
					end
			RP: begin ns = (valid&makeBreak)?((outCode == 8'h75)?UP:(outCode == 8'h6B)?LP:(outCode == 8'h72)?DP:(outCode == 8'h74)?RP:IDLE):IDLE;
							directionCommand = 4'b0001;
					end
			UP: begin ns = (valid&makeBreak)?((outCode == 8'h75)?UP:(outCode == 8'h6B)?LP:(outCode == 8'h72)?DP:(outCode == 8'h74)?RP:IDLE):IDLE;
							directionCommand = 4'b0100;
					end
			DP: begin ns = (valid&makeBreak)?((outCode == 8'h75)?UP:(outCode == 8'h6B)?LP:(outCode == 8'h72)?DP:(outCode == 8'h74)?RP:IDLE):IDLE;
							directionCommand = 4'b0010;
					end
			default: begin ns = IDLE;
								directionCommand = 4'b0000;
						end
		endcase
	end
	
	always_ff@(posedge clk)begin
		if(reset)begin
			ps <= IDLE;
		end else begin
			ps <= ns;
		end
	end
	
endmodule 